{{#if navigation.length}}

  <ul class="nav-list">
  {{#each navigation}}

    {{#if (and this.componentHeader (has-visible-items this.items))}}
    {{!-- Overview (page-tab-overview) pages are intentionally not rendered in the
         left nav: the tab already links to that URL. The tabOverview items stay in
         this.items but are skipped here and by the {{#unless this.tabOverview}} guard
         below, so they never appear as a nav entry. --}}
    {{!-- The component+version match below only implies is-active when this is the sole
         top-level block for that component+version (soleBlock) - page-tabs-promote-sections
         can split one docset into several sibling blocks sharing the same component+version,
         and matching on that alone would mark all of them active instead of just the one
         actually containing the current page (contains-url handles that case instead). --}}
    <li class="nav-item docset-title{{#if (or (and this.soleBlock (eq this.component @root.page.component.name) (eq this.componentVersion @root.page.version)) (contains-url this.items @root.page.url) @root.page.attributes.navOpenDocsets)}} is-active{{/if}}{{#if (eq this.component @root.page.component.name)}}{{#unless (eq this.componentVersion @root.page.version)}} hidden{{/unless}}{{/if}}" data-component="{{this.component}}" data-version="{{this.componentVersion}}"{{#with this.pageTabs}} data-tabs="{{this}}"{{/with}} data-depth="{{or ../level 0}}">
      <span class="nav-text nav-item-toggle">
        {{{this.componentTitle}}}
      </span>
      {{> nav-tree navigation=this.items level=(increment ../level) module=(or this.module ../module) show=../show}}
    </li>
    {{/if}}
    {{#unless this.componentHeader}}
    {{#unless this.tabOverview}}
    <li class="nav-item{{#if (eq this.url @root.page.url)}} is-current-page{{/if}}{{#if this.componentHeader}} docset-divider{{/if}}"{{#with this.pageTabs}} data-tabs="{{this}}"{{/with}} data-module="{{or ../module this.module}}" data-depth="{{or ../level 0}}"{{#with this.component}} data-component="{{this}}"{{/with}}{{#with this.componentVersion}} data-version="{{this}}"{{/with}}{{#with this.asciidoc}} data-slug="{{this.attributes.page-slug}}"{{/with}}>
      {{#if this.content}}
      {{#if this.url}}
      <a class="sidebar-link{{#if this.items.length}} nav-item-toggle{{/if}}" data-depth="{{or ../level 0}}" href="
        {{~#if (eq this.urlType 'internal')}}{{{fix-nav-path this.url @root.page}}}
        {{~else}}{{{this.url}}}{{~/if}}">{{{this.content}}}</a>
      {{else if this.items.length }}
      <span class="nav-text nav-item-toggle">{{{this.content}}}</span>
      {{else if (has-string this.content "href=") }}
        {{{this.content}}}
      {{else}}
      <span class="nav-text nav-section-header">
        {{{this.content}}}
        </span>
      {{/if}}
      {{/if}}
        {{> nav-tree navigation=this.items level=(increment ../level) module=(or this.module ../module) show=../show}}
    </li>
    {{/unless}}
    {{/unless}}

  {{/each}}
  </ul>

{{/if}}
