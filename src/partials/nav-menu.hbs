{{!-- Cheat-sheet pages replace this server-rendered nav with a heading-derived
     one at runtime (02-on-this-page.js's buildCheatSheetNav) - there's no
     separate cheat-sheet branch here any more, so #nav-root reliably exists
     for that script to mount into, same as every other page. --}}
<div class="nav-panel-menu is-active" data-panel="menu">
  {{#with page.navigation}}
    {{#with (nav-aggregate this @root.page.attributes.tabNav (lookup @root.page.attributes 'tabs-group') @root.page.version)}}
      <nav id="nav-root" class="nav-menu nav-menu-aggregated">
        {{> nav-tree navigation=this }}
      </nav>
    {{/with}}
  {{/with}}

</div>